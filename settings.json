{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "UV_CACHE_DIR": "/tmp/claude-501/uv-cache",
    "npm_config_cache": "/tmp/claude-501/npm-cache",
    "GOCACHE": "/tmp/claude-501/go-build",
    "GOMODCACHE": "/tmp/claude-501/go-mod"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make tree)",
      "Bash(source .venv/bin/activate)",
      "Bash(source venv/bin/activate)",
      "Bash(git status)",
      "Bash(git -C * status)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(git fetch *)",
      "Bash(git -C * fetch *)",
      "Bash(git pull *)",
      "Bash(git -C * pull *)",
      "Bash(git worktree *)",
      "Bash(git -C * worktree *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(glab mr view*)",
      "Bash(glab mr list*)",
      "Bash(glab mr diff*)",
      "Bash(glab issue view*)",
      "Bash(glab issue list*)",
      "Bash(glab ci list*)",
      "Bash(glab ci get*)",
      "Bash(glab ci status*)",
      "Bash(glab ci trace*)",
      "Read(~/.claude/agents/**)",
      "Read(~/.claude/commands/**)",
      "Read(~/.claude/hooks/**)",
      "Read(~/.claude/output-styles/**)",
      "Read(~/.claude/rules/**)",
      "Read(~/.claude/scripts/**)",
      "Read(~/.claude/shared/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/templates/**)",
      "Skill",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "mcp__claude_ai_Mermaid_Chart__validate_and_render_mermaid_diagram",
      "mcp__claude-context__get_indexing_status",
      "mcp__claude-context__search_code",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(wget * | bash*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(curl * | bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(curl * | sh*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean -f*)",
      "Bash(git -C * clean -d*)",
      "Bash(git -C * clean -x*)",
      "Bash(gh *delete*)",
      "Bash(gh api *DELETE*)",
      "Bash(glab * del*)",
      "Bash(glab api *DELETE*)",
      "Bash(glab token revoke*)",
      "Bash(glab token create*)",
      "Bash(glab token rotate*)",
      "Bash(glab variable *)",
      "Bash(glab api *variables*)",
      "Bash(glab config get *token*)",
      "Bash(glab auth status *--show-token*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh secret *)",
      "Bash(security *)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(~/.zsh_history)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git branch -D *)",
      "Bash(git remote *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)",
      "Bash(git -C * merge *)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * reset*)",
      "Bash(git -C * cherry-pick *)",
      "Bash(git -C * revert *)",
      "Bash(git -C * tag *)",
      "Bash(git -C * branch -D *)",
      "Bash(git -C * remote *)",
      "Bash(git -C * filter-branch *)",
      "Bash(git -C * filter-repo *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh workflow run *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(glab mr merge *)",
      "Bash(glab mr approve *)",
      "Bash(glab mr close *)",
      "Bash(glab mr reopen *)",
      "Bash(glab mr rebase *)",
      "Bash(glab issue create *)",
      "Bash(glab issue note *)",
      "Bash(glab issue update *)",
      "Bash(glab issue close *)",
      "Bash(glab ci run*)",
      "Bash(glab ci retry *)",
      "Bash(glab ci cancel *)",
      "Bash(glab release *)",
      "Bash(npx *)",
      "Bash(npm exec*)",
      "Bash(uvx *)",
      "Bash(brew install*)",
      "Bash(brew uninstall*)",
      "Bash(brew upgrade*)",
      "Bash(brew services *)",
      "Bash(docker *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(launchctl *)",
      "Bash(defaults write *)",
      "Bash(defaults delete *)",
      "Bash(crontab *)",
      "Bash(networksetup *)",
      "Bash(pmset *)",
      "Bash(scutil *)",
      "Bash(osascript *)",
      "mcp__claude-context__clear_index"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Forge MR/PR collaboration: updating a merge request's or pull request's title or description, posting comments on it, replying to its review discussions, and resolving or unresolving those discussions, via glab/gh subcommands or glab api/gh api (REST or GraphQL). Does not cover merging, approving, closing, reopening, changing the target or base branch, or deleting anything."
    ],
    "soft_deny": [
      "$defaults",
      "Forge configuration changes: changing GitLab project or GitHub repo settings, protected branches or tags, members or permissions, webhooks, deploy keys, CI/CD variables or secrets, or pipeline schedules, via glab/gh or their APIs."
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/list-excluded-commands.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/standalone-excluded-commands.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/lint-and-test.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "outputStyle": "lean",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "platform.claude.com",
        "code.claude.com",
        "docs.claude.com"
      ],
      "allowAllUnixSockets": false
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/skills-references"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.claude/skills-references",
        "~/.claude/agents",
        "~/.claude/commands",
        "~/.claude/hooks",
        "~/.claude/output-styles",
        "~/.claude/rules",
        "~/.claude/scripts",
        "~/.claude/shared",
        "~/.claude/skills",
        "~/.claude/templates"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "make install",
      "git fetch *",
      "git pull *",
      "git add *",
      "git merge *",
      "git commit *",
      "git push *",
      "git worktree *",
      "git -C * fetch *",
      "git -C * pull *",
      "git -C * add *",
      "git -C * merge *",
      "git -C * commit *",
      "git -C * push *",
      "git -C * worktree *",
      "gh *",
      "glab *",
      "go mod download *",
      "go mod tidy *",
      "go get *",
      "agent-browser *"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "companyAnnouncements": [
    "It is recommended that each repo defines make lint, make test, and make tree targets, as user-level Claude Code workflows rely on them."
  ],
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark"
}
