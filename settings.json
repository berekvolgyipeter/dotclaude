{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "UV_CACHE_DIR": "/tmp/claude-501/uv-cache",
    "npm_config_cache": "/tmp/claude-501/npm-cache",
    "GOCACHE": "/tmp/claude-501/go-build",
    "GOMODCACHE": "/tmp/claude-501/go-mod"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make tree)",
      "Bash(source .venv/bin/activate)",
      "Bash(source venv/bin/activate)",
      "Bash(git status)",
      "Bash(gh api *)",
      "Bash(glab api *)",
      "Skill",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "mcp__claude_ai_Mermaid_Chart__validate_and_render_mermaid_diagram",
      "mcp__claude-context__get_indexing_status",
      "mcp__claude-context__search_code",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(wget * | bash*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(curl * | bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(curl * | sh*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(gh *delete*)",
      "Bash(gh api *DELETE*)",
      "Bash(glab * del*)",
      "Bash(glab api *DELETE*)",
      "Bash(glab token revoke*)",
      "Bash(security *)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(~/.zsh_history)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(glab mr create *)",
      "Bash(glab mr merge *)",
      "Bash(glab mr update *)",
      "Bash(glab mr note *)",
      "Bash(glab release *)",
      "Bash(glab api *-X*)",
      "Bash(glab api *--method*)",
      "Bash(glab api *-f*)",
      "Bash(glab api *-F*)",
      "Bash(glab api *--input*)",
      "Bash(npx *)",
      "Bash(npm exec*)",
      "Bash(uvx *)",
      "Bash(brew install*)",
      "Bash(brew uninstall*)",
      "Bash(brew services *)",
      "Bash(docker *)",
      "Bash(curl --unix-socket*)",
      "Bash(socat *UNIX*)",
      "Bash(nc -U *)",
      "Bash(ncat --unixsock*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(launchctl *)",
      "Bash(defaults write *)",
      "Bash(defaults delete *)",
      "Bash(crontab *)",
      "Bash(networksetup *)",
      "Bash(pmset *)",
      "Bash(scutil *)",
      "Bash(osascript *)",
      "mcp__claude-context__index_codebase",
      "mcp__claude-context__clear_index"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "claude-context",
    "context7"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sync-links.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"IMPORTANT: run each of these as the ONLY command in its Bash call — no |, &&, ||, ;, cd, $() or redirects; otherwise it is sandboxed and fails: \" + (.sandbox.excludedCommands | join(\", \"))' $HOME/.claude/settings.json"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/load-context-rules.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/standalone-excluded-commands.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/lint-and-test.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "outputStyle": "lean",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "make install",
      "git fetch *",
      "git pull *",
      "git push *",
      "bash ~/.claude/scripts/review/pr-diff.sh *",
      "gh *",
      "glab *",
      "go mod download *",
      "go mod tidy *",
      "go get *",
      "agent-browser *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "platform.claude.com",
        "code.claude.com",
        "docs.claude.com"
      ],
      "allowAllUnixSockets": false
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/skills-references"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.claude/skills-references"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITLAB_TOKEN", "mode": "deny" }
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "companyAnnouncements": [
    "It is recommended that each repo defines make lint, make test, and make tree targets, as user-level Claude Code workflows rely on them."
  ],
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark"
}
