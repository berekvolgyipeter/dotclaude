{
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make tree)",
      "Bash(source .venv/bin/activate)",
      "Bash(source venv/bin/activate)",
      "Bash(git status)",
      "Skill",
      "WebSearch",
      "mcp__claude-context__get_indexing_status",
      "mcp__claude-context__search_code",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__sequential-thinking__sequentialthinking",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__search_for_pattern"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(wget * | bash*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(curl * | bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(curl * | sh*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Edit(**/.env)",
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)"
    ],
    "ask": [
      "Bash(docker *)",
      "Bash(curl --unix-socket*)",
      "Bash(socat *UNIX*)",
      "Bash(nc -U *)",
      "Bash(ncat --unixsock*)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(launchctl *)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "claude-context",
    "context7",
    "sequential-thinking",
    "serena"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/auto-approve-claude-dir.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-rm-rf.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-push-to-main.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/load-context-rules.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/stop-lint-and-test.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "platform.claude.com",
        "code.claude.com"
      ],
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp"
      ],
      "allowRead": [
        "~/.ssh/known_hosts"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "companyAnnouncements": [
    "It is recommended that each repo defines make lint, make test, and make tree targets, as user-level Claude Code workflows rely on them."
  ],
  "plansDirectory": ".claude/plans",
  "autoMemoryEnabled": false,
  "effortLevel": "medium"
}
